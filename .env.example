# ─── Site ────────────────────────────────────────────────────────────────
# The real domain. Used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://logosa.com.np

# ─── Enquiries ───────────────────────────────────────────────────────────
# Without one of these, /api/inquiry formats the enquiry but delivers nothing
# and tells the visitor so. See LAUNCH.md §3.
#
# Option A — post JSON to a webhook (Zapier, Make, a CRM, a Sheet endpoint)
# INQUIRY_WEBHOOK_URL=

# Option B — send email via Resend
# RESEND_API_KEY=
# INQUIRY_TO_EMAIL=hello@example.com

# ─── Map ─────────────────────────────────────────────────────────────────
# Optional. Without it the map section renders the drawn atlas fallback,
# which is a designed state rather than a broken one.
# Restrict this token to your domain — it ships to the browser.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Conditions ──────────────────────────────────────────────────────────
# Live weather comes from Open-Meteo, which needs no key. Set to 1 to turn
# the feature off entirely; the UI then hides itself rather than erroring.
# CONDITIONS_DISABLED=0
